<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:fa="clr-namespace:UraniumUI.Icons.FontAwesome;assembly=UraniumUI.Icons.FontAwesome"
             x:Class="GPili.Mobile.Presentation.Contents.Cashier.CartTotalView">
    <Border Grid.Row="2"
        Background="#1A72DD"
        VerticalOptions="End"
        HorizontalOptions="Fill"
        HeightRequest="70"
        Margin="20"
        Padding="15"
        StrokeShape="RoundRectangle 15"
        StrokeThickness="0">

        <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalOptions="Center">
            <!-- Cart Icon -->
            <Image Grid.Column="0"
       WidthRequest="28" HeightRequest="28"
       VerticalOptions="Center" HorizontalOptions="Start">
                <Image.Source>
                    <FontImageSource FontFamily="FASolid"
                         Glyph="{x:Static fa:Solid.CartShopping}"
                         Color="White"/>
                </Image.Source>
            </Image>

            <!-- Items label -->
            <Label Grid.Column="1"
       Text="{Binding Tenders.Count, StringFormat='{}{0} Items'}"
       TextColor="White"
       FontSize="16"
       FontAttributes="Bold"
       VerticalOptions="Center"
       HorizontalOptions="Start"
       Margin="10,0,0,0"/>

            <!-- Total Price -->
            <Label Grid.Column="2"
       Text="Total: "
       TextColor="White"
       FontSize="18"
       FontAttributes="Bold"
       VerticalOptions="Center"
       HorizontalOptions="End"/>

            <Label Grid.Column="3"
       Text="{Binding Tenders.GrossTotal}"
       TextColor="White"
       FontSize="18"
       FontAttributes="Bold"
       VerticalOptions="Center"
       HorizontalOptions="End"/>
        </Grid>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding BindingContext.NavigateToCartCommand}"/>
        </Border.GestureRecognizers>
    </Border>
</ContentView>
