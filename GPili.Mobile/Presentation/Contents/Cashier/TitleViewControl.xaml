<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converter="clr-namespace:GPili.Mobile.Converters"
             x:Class="GPili.Mobile.Presentation.Contents.Cashier.TitleViewControl">
    <ContentView.Resources>
        <converter:GreaterThanZeroToBoolConverter x:Key="GreaterThanZeroToBoolConverter" />
    </ContentView.Resources>
    <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center" HorizontalOptions="Fill" Margin="20,0,20,0">

        <Button Text="Void" BackgroundColor="Red"
            Grid.Column="0" Command="{Binding VoidOrderCommand}" 
                IsVisible="{Binding Tenders.Count, Converter={StaticResource GreaterThanZeroToBoolConverter}}"/>
        
        <Label Text="Train Mode" TextColor="Red" x:Name="TrainLabel" Grid.Column="1" 
               HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>

        <Button Text="Manager" BackgroundColor="Red"
            Grid.Column="2" Command="{Binding ManagerCommand}" />
    </Grid>
</ContentView>
