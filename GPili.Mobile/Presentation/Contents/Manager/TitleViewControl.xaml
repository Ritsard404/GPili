<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:fa="clr-namespace:UraniumUI.Icons.FontAwesome;assembly=UraniumUI.Icons.FontAwesome"
             x:Class="GPili.Mobile.Presentation.Contents.Manager.TitleViewControl">
    <Grid  x:Name="BackButton" ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center" 
           HorizontalOptions="Fill" Margin="20,0,20,0" >
        <!--CornerRadius="5" Command="{Binding BackCashieringCommand}">-->
        <ImageButton WidthRequest="28" HeightRequest="28" Grid.Column="0"
                                     CornerRadius="5" Command="{Binding BackCashieringCommand}">
            <ImageButton.Source>
                <FontImageSource Glyph="{x:Static fa:Solid.ArrowLeft}"
                                     Color="Red" Size="12"/>
            </ImageButton.Source>
        </ImageButton>
        <Button 
            Text="Log Out"
            Grid.Column="2" Margin="5"
            BackgroundColor="Red"
            TextColor="White"
            CornerRadius="8"
            ContentLayout="Right,10"
            ImageSource="logout.png" /> 


    </Grid>
</ContentView>
