<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GPili.Mobile.Presentation.Features.Manager.Sales.TranxListPage"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             xmlns:fa="clr-namespace:UraniumUI.Icons.FontAwesome;assembly=UraniumUI.Icons.FontAwesome"
             xmlns:loader="clr-namespace:GPili.Mobile.Presentation.Contents"
             Title="{Binding TransactionListTitle}">
    <Grid RowDefinitions="Auto,Auto, *, Auto"
       HorizontalOptions="Fill" VerticalOptions="Fill"
       Padding="5">
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="10">
            <HorizontalStackLayout Grid.Row="0" HorizontalOptions="Center" Spacing="20">
                <material:DatePickerField Title="From:" Date="{Binding From}"
                HorizontalOptions="Fill" 
                Grid.Column="0"/>

                <material:DatePickerField Title="To:" Date="{Binding To}" 
                     HorizontalOptions="Fill"
                     Grid.Column="1"/>
            </HorizontalStackLayout>
            <Label Text="{Binding TranxCount}" Grid.Row="1" HorizontalOptions="Start" VerticalOptions="Center"/>

            <Button Text="Search" Grid.Row="1" Command="{Binding SearchInvoicesCommand}"
                    WidthRequest="150" HorizontalOptions="End">
                <Button.ImageSource>
                    <FontImageSource FontFamily="FASolid"
                         Glyph="{x:Static fa:Solid.MagnifyingGlass}"
                         Color="White" Size="16"/>
                </Button.ImageSource>
            </Button>
        </Grid>
        <ScrollView Grid.Row="2" Margin="0,20,0,0">
            <Grid  RowDefinitions="Auto, *">
                <Border Grid.Row="0"
            Stroke="Transparent"
            StrokeShape="RoundRectangle 12,12,0,0"
            StrokeThickness="0" HeightRequest="50"
            Background="#383949" Padding="15">
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="15">
                        <Label Text="Type" Grid.Column="0" FontAttributes="Bold" 
                    HorizontalOptions="Start" VerticalOptions="Center" TextColor="White"/>
                        <Label Text="Status" Grid.Column="1" FontAttributes="Bold" 
                    HorizontalOptions="Start" VerticalOptions="Center" TextColor="White"/>
                        <Label Text="Date" Grid.Column="2" FontAttributes="Bold" 
                    HorizontalOptions="Start" VerticalOptions="Center" TextColor="White"/>
                        <Label Text="Action" Grid.Column="3" FontAttributes="Bold" 
                    HorizontalOptions="Center" VerticalOptions="Center" TextColor="White"/>
                    </Grid>
                </Border>
                <Border Grid.Row="1"
            Stroke="Transparent"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 0,0,12,12"
            Background="#121125" Margin="0,0,0,5">
                    <CollectionView
                ItemsSource="{Binding TransactLists}"
                SelectionMode="Single"
                Margin="0,0,0,5"
                ItemSizingStrategy="MeasureAllItems">

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,*,*,*"
                        ColumnSpacing="15" Padding="15,5,15,5">

                                    <Label Text="{Binding TypeDisplay}" Grid.Column="0" 
                           VerticalOptions="Center" HorizontalOptions="Start" TextColor="White"/>

                                    <Label Text="{Binding Status}" Grid.Column="1" 
                           VerticalOptions="Center" HorizontalOptions="Start" TextColor="White"/>

                                    <Label Text="{Binding CreatedAt}" Grid.Column="2" 
                           VerticalOptions="Center" HorizontalOptions="Start" TextColor="White"/>

                                    <Button Text="Print" Grid.Column="3"
                                    WidthRequest="95" HeightRequest="45"  TextColor="White"
                                    Command="{Binding BindingContext.RePrintInvoiceCommand, Source={x:Reference TransactListRoot}}"
                                    CommandParameter="{Binding .}">
                                        <Button.ImageSource>
                                            <FontImageSource FontFamily="FASolid"
                                     Glyph="{x:Static fa:Solid.Print}"
                                     Size="16"/>
                                        </Button.ImageSource>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </Border>
            </Grid>
        </ScrollView>
        
        <loader:LoaderView Grid.Row="0" Grid.RowSpan="5" IsVisible="{Binding IsLoading}"/>

    </Grid>
</ContentPage>