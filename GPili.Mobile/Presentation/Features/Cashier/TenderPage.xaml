<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GPili.Mobile.Presentation.Features.Cashier.TenderPage"
             xmlns:controls="clr-namespace:GPili.Mobile.Presentation.Contents.Cashier"
             xmlns:loader="clr-namespace:GPili.Mobile.Presentation.Contents"
             Shell.FlyoutBehavior="Disabled"
             Title="" x:Name="CashierPageRoot">
    <Shell.TitleView>
        <controls:TitleViewControl />
    </Shell.TitleView>

    <Grid RowDefinitions="Auto,*, Auto" Margin="0,20,0,20">
        <controls:CartTotalView Grid.Row="2"/>
        <loader:LoaderView Grid.Row="0" Grid.RowSpan="4" IsVisible="{Binding IsLoading}"/>
    </Grid>
</ContentPage>