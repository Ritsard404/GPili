<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GPili.Mobile.Presentation.Features.Cashier.CashierPage"
             xmlns:controls="clr-namespace:GPili.Mobile.Presentation.Contents.Cashier"
             xmlns:loader="clr-namespace:GPili.Mobile.Presentation.Contents"
             xmlns:model="clr-namespace:ServiceLibrary.Models;assembly=ServiceLibrary"
             xmlns:fa="clr-namespace:UraniumUI.Icons.FontAwesome;assembly=UraniumUI.Icons.FontAwesome"
             xmlns:converter="clr-namespace:GPili.Mobile.Converters"
             Shell.FlyoutBehavior="Disabled"
             Title="" x:Name="CashierPageRoot"
             >
    <Shell.TitleView>
        <controls:TitleViewControl />
    </Shell.TitleView>
    <ContentPage.Resources>
        <converter:InverseBoolConverter x:Key="InverseBoolConverter" />
        <converter:IsNullOrEmptyConverter x:Key="IsNullOrEmptyConverter" />
        <converter:PlatformImageSourceConverter x:Key="PlatformImageSourceConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*, Auto" Margin="0,20,0,20">
        <CollectionView  Grid.Row="0" ItemsSource="{Binding Categories}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout ItemSpacing="10" Orientation="Horizontal"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="20, 0" HeightRequest="50" StrokeShape="RoundRectangle 10" BackgroundColor="Gold">
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="{Binding CtgryName}" VerticalOptions="Center" VerticalTextAlignment="Center"
                                                   FontAttributes="Bold" TextColor="Maroon" FontSize="20" >
                                <Label.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}"
                                                      TargetType="Label"
                                                      Value="True">
                                        <Setter Property="TextColor" Value="Black"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                        <Border.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}"
                                                     TargetType="Border"
                                                     Value="True">
                                <Setter Property="Background" Value="AliceBlue"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BindingContext.SelectCategoryCommand, Source={x:Reference CashierPageRoot}}"
                                                              CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <CollectionView Grid.Row="1"
                Margin="20"
                ItemsSource="{Binding Products}"
                SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:Product">
                    <Border Padding="10"
                    StrokeShape="RoundRectangle 15"
                    BackgroundColor="#E3F2FD"
                    Stroke="#0288D1"
                    HorizontalOptions="Fill">

                        <Grid ColumnDefinitions="100,*,50"
                      RowDefinitions="Auto,Auto,Auto"
                      ColumnSpacing="10"
                      VerticalOptions="Center">

                            <!-- Product Image -->
                            <Image Grid.RowSpan="3"
                           Grid.Column="0"
                           Source="{Binding ImageSourcePath}"
                           WidthRequest="80" HeightRequest="80"
                           Aspect="AspectFill"
                           HorizontalOptions="Start"
                           VerticalOptions="Center"
                           IsVisible="{Binding HasImage}" />

                            <!-- Fallback Icon -->
                            <Image Grid.RowSpan="3"
                           Grid.Column="0"
                           Source="food_tray.png"
                           WidthRequest="80" HeightRequest="80"
                           Aspect="AspectFill"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           IsVisible="{Binding HasImage, Converter={StaticResource InverseBoolConverter}}"/>
                            <!--<Image Grid.RowSpan="2"
                           Grid.Column="0"
                           Aspect="AspectFit"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           IsVisible="{Binding HasImage, Converter={StaticResource InverseBoolConverter}}">
                                <Image.Source>
                                    <FontImageSource Glyph="{x:Static fa:Solid.Image}"
                                             Color="Gray" Size="30"/>
                                </Image.Source>
                            </Image>-->

                            <!-- Product Name -->
                            <Label Grid.Column="1"
                           Text="{Binding Name}"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#01579B"
                           VerticalOptions="End"
                           HorizontalOptions="Start"/>

                            <!-- Product Price -->
                            <Label Grid.Column="1" Grid.Row="1"
                           Text="{Binding Price, StringFormat='₱{0:F2}'}"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#D32F2F"
                           VerticalOptions="Start"
                           HorizontalOptions="Start"/>

                            <!-- Product Quantity -->
                            <Label Grid.Column="1" Grid.Row="2"
                           Text="{Binding Quantity}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="Grey"
                           VerticalOptions="Start"
                           HorizontalOptions="Start"/>

                            <!-- Add (+) Button -->
                            <Button Grid.Column="2"
                            Grid.RowSpan="3"
                            Text="+"
                            FontSize="20"
                            BackgroundColor="#0288D1"
                            TextColor="White"
                            CornerRadius="10"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Command="{Binding BindingContext.AddItemCommand, Source={x:Reference CashierPageRoot}}"
                            CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <controls:CartTotalView Grid.Row="2"/>
        <loader:LoaderView Grid.Row="0" Grid.RowSpan="4" IsVisible="{Binding IsLoading}"/>
    </Grid>
</ContentPage>