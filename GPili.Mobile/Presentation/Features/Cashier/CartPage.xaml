<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GPili.Mobile.Presentation.Features.Cashier.CartPage"
             xmlns:controls="clr-namespace:GPili.Mobile.Presentation.Contents.Cashier"
             xmlns:fa="clr-namespace:UraniumUI.Icons.FontAwesome;assembly=UraniumUI.Icons.FontAwesome"
             xmlns:loader="clr-namespace:GPili.Mobile.Presentation.Contents"
             xmlns:converter="clr-namespace:GPili.Mobile.Converters"
             Shell.FlyoutBehavior="Disabled"
             Title="" x:Name="CartPageRoot">
    <ContentPage.Resources>
        <converter:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <converter:ItemIndexConverter x:Key="ItemIndexConverter"/>
        <converter:GreaterThanZeroToBoolConverter x:Key="GreaterThanZeroToBoolConverter"/>
    </ContentPage.Resources>
    <Shell.TitleView>
        <controls:TitleViewControl />
    </Shell.TitleView>

    <Grid RowDefinitions="Auto,*, Auto" Margin="0,20,0,20">
        <CollectionView x:Name="OrderItemsCollectionView"
                Grid.Row="1"
                ItemsSource="{Binding Items}"
                SelectionMode="None"
                VerticalOptions="Fill"
                Margin="12">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="White"
                        Stroke="#E0E0E0"
                        HorizontalOptions="Fill"
                        Margin="4">

                        <Grid ColumnDefinitions="80,*,Auto"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="10"
                              RowSpacing="4"
                              VerticalOptions="Center">

                            <!-- Product Image -->
                            <Image Grid.RowSpan="2"
                               Grid.Column="0"
                               Source="{Binding ImageSourcePath}"
                               WidthRequest="70" HeightRequest="70"
                               Aspect="AspectFill"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               IsVisible="{Binding HasImage}" />

                            <!-- Fallback Icon -->
                            <Image Grid.RowSpan="2"
                               Grid.Column="0"
                               Source="food_tray.png"
                               WidthRequest="80" HeightRequest="80"
                               Aspect="AspectFill"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               IsVisible="{Binding HasImage, Converter={StaticResource InverseBoolConverter}}"/>

                            <!-- Product Name -->
                            <Label Grid.Column="1" Grid.Row="0"
                               Text="{Binding Product.Name}"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="#212121"
                               LineBreakMode="TailTruncation"
                               VerticalOptions="Center"
                               HorizontalOptions="Start"/>

                            <!-- Subtotal (align right, same row as name for balance) -->
                            <Label Grid.Column="2" Grid.Row="1"
                                Text="{Binding DisplaySubtotalVat}"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#D32F2F"
                                VerticalOptions="Center"
                                HorizontalOptions="End"/>

                            <!-- Price × Qty (row 1, left side) -->
                            <HorizontalStackLayout Grid.Column="1" Grid.Row="1" Spacing="5">
                                <Label Text="{Binding DisplayPrice}"
                                   FontAttributes="Bold"
                                   FontSize="13"
                                   TextColor="#0288D1"
                                   VerticalOptions="Center"/>
                                                <Label Text="x"
                                   FontSize="13"
                                   TextColor="#0288D1"
                                   VerticalOptions="Center"/>
                                                <Label Text="{Binding Qty}"
                                   FontAttributes="Bold"
                                   FontSize="13"
                                   TextColor="#0288D1"
                                   VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <!-- Qty Controls (row 1, right side) --><!--
                            <HorizontalStackLayout Grid.Column="2" Grid.Row="1" Spacing="4"
                               VerticalOptions="Center"
                               HorizontalOptions="End">

                                <ImageButton WidthRequest="28" HeightRequest="28"
                                     CornerRadius="5" BackgroundColor="#FFEB3B"
                                     Command="{Binding BindingContext.DecreaseQtyCommand, Source={x:Reference CartPageRoot}}"
                                     CommandParameter="{Binding .}">
                                    <ImageButton.Source>
                                        <FontImageSource Glyph="{x:Static fa:Solid.Minus}"
                                     Color="Black" Size="12"/>
                                    </ImageButton.Source>
                                </ImageButton>

                                <Label Text="{Binding Qty}"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   TextColor="#212121"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"/>

                                <ImageButton WidthRequest="28" HeightRequest="28"
                                     CornerRadius="5" BackgroundColor="#FFEB3B"
                                     Command="{Binding BindingContext.IncreaseQtyCommand, Source={x:Reference CartPageRoot}}"
                                     CommandParameter="{Binding .}">
                                    <ImageButton.Source>
                                        <FontImageSource Glyph="{x:Static fa:Solid.Plus}"
                                     Color="Black" Size="12"/>
                                    </ImageButton.Source>
                                </ImageButton>
                            </HorizontalStackLayout>-->
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BindingContext.SelectItemCommand, Source={x:Reference CartPageRoot}}"
                                                  CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>
                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>


        <controls:CartTotalView Grid.Row="2"/>
        <loader:LoaderView Grid.Row="0" Grid.RowSpan="4" IsVisible="{Binding IsLoading}"/>
    </Grid>
</ContentPage>